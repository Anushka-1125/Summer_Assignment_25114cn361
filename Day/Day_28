//Program-1

#include <stdio.h>
struct Book
{
    int bookID;
    char title[50];
    char author[50];
};
int main()
{
    struct Book b;
    printf("Enter Book ID: ");
    scanf("%d", &b.bookID);
    printf("Enter Book Title: ");
    scanf("%s", b.title);
    printf("Enter Author Name: ");
    scanf("%s", b.author);
    printf("\n----- Book Details -----\n");
    printf("Book ID     : %d\n", b.bookID);
    printf("Book Title  : %s\n", b.title);
    printf("Author Name : %s\n", b.author);
    return 0;
}


//Program-2

#include <stdio.h>
int main()
{
    int accountNo, choice;
    char name[50];
    float balance = 0, amount;
    printf("Enter Account Number: ");
    scanf("%d", &accountNo);
    printf("Enter Account Holder Name: ");
    scanf("%s", name);
    do
    {
        printf("\n===== BANK MENU =====\n");
        printf("1. Deposit\n");
        printf("2. Withdraw\n");
        printf("3. Check Balance\n");
        printf("4. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &choice);
        switch(choice)
        {
            case 1:
                printf("Enter Deposit Amount: ");
                scanf("%f", &amount);
                balance += amount;
                printf("Deposit Successful.\n");
                break;
            case 2:
                printf("Enter Withdrawal Amount: ");
                scanf("%f", &amount);
                if(amount <= balance)
                {
                    balance -= amount;
                    printf("Withdrawal Successful.\n");
                }
                else
                {
                    printf("Insufficient Balance.\n");
                }
                break;
            case 3:
                printf("Current Balance = %.2f\n", balance);
                break;
            case 4:
                printf("Thank You!\n");
                break;
            default:
                printf("Invalid Choice!\n");
        }
    } while(choice != 4);
    return 0;
}


//Program-3

#include <stdio.h>
int main()
{
    char title[50];
    int totalPages, currentPage;
    printf("Enter Book Title: ");
    scanf("%s", title);
    printf("Enter Total Pages: ");
    scanf("%d", &totalPages);
    printf("Enter Current Page: ");
    scanf("%d", &currentPage);
    printf("\n----- Reading Status -----\n");
    printf("Book Title    : %s\n", title);
    printf("Total Pages   : %d\n", totalPages);
    printf("Current Page  : %d\n", currentPage);
    printf("Pages Left    : %d\n", totalPages - currentPage);
    return 0;
}


