//Program-1

//Write a program to Check perfect number. 


#include <stdio.h>
int main()
{
    int n, i, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    for(i = 1; i < n; i++)
    {
        if(n % i == 0)
            sum += i;
    }

    if(sum == n)
        printf("%d is a Perfect Number.", n);
    else
        printf("%d is not a Perfect Number.", n);

    return 0;
}


//Program-2

//Write a program to Check strong number. 


#include <stdio.h>
int main()
{
    int n, i;

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("Factors of %d are:\n", n);

    for(i = 1; i <= n; i++)
    {
        if(n % i == 0)
            printf("%d ", i);
    }

    return 0;
}


//Program-3

//Write a program to Print factors of a number. 


#include <stdio.h>
int main()
{
    int n, temp, digit, sum = 0, i, fact;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while(temp > 0)
    {
        digit = temp % 10;
        fact = 1;

        for(i = 1; i <= digit; i++)
            fact *= i;

        sum += fact;
        temp /= 10;
    }

    if(sum == n)
        printf("%d is a Strong Number.", n);
    else
        printf("%d is not a Strong Number.", n);

    return 0;
}


//Program-4

//Write a program to Find largest prime factor. 


#include <stdio.h>
int main()
{
    int n, i;
    int largestPrimeFactor = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    for(i = 2; i <= n; i++)
    {
        while(n % i == 0)
        {
            largestPrimeFactor = i;
            n /= i;
        }
    }

    printf("Largest Prime Factor = %d", largestPrimeFactor);

    return 0;
}
