//Program-1

public class StarPyramid {
    public static void main(String args[]) {

        int n = 5;

        for(int i = 1; i <= n; i++) {

            for(int j = 1; j <= n - i; j++)
                System.out.print(" ");

            for(int j = 1; j <= 2 * i - 1; j++)
                System.out.print("*");

            System.out.println();
        }
    }
}
Output:
    *
   ***
  *****
 *******
*********


//Program-2

public class ReversePyramid {
    public static void main(String args[]) {

        int n = 5;

        for(int i = n; i >= 1; i--) {

            for(int j = 1; j <= n - i; j++)
                System.out.print(" ");

            for(int j = 1; j <= 2 * i - 1; j++)
                System.out.print("*");

            System.out.println();
        }
    }
}
Output:
*********
 *******
  *****
   ***
    *


//Program-3

public class NumberPyramid {
    public static void main(String args[]) {

        int n = 5;

        for(int i = 1; i <= n; i++) {

            for(int j = 1; j <= n - i; j++)
                System.out.print(" ");

            for(int j = 1; j <= i; j++)
                System.out.print(j);

            for(int j = i - 1; j >= 1; j--)
                System.out.print(j);

            System.out.println();
        }
    }
}
Output:
    1
   121
  12321
 1234321
123454321


//Program-4

public class CharacterPyramid {
    public static void main(String args[]) {

        int n = 5;

        for(int i = 1; i <= n; i++) {

            for(int j = 1; j <= n - i; j++)
                System.out.print(" ");

            for(char ch = 'A'; ch < 'A' + i; ch++)
                System.out.print(ch);

            for(char ch = (char)('A' + i - 2); ch >= 'A'; ch--)
                System.out.print(ch);

            System.out.println();
        }
    }
}
Output:
    A
   ABA
  ABCBA
 ABCDCBA
ABCDEDCBA
