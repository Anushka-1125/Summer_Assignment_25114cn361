}


//Program-4

#include <stdio.h>
struct Hotel
{
    int roomNo;
    char customer[50];
    int days;
    float charge;
};
int main()
{
    struct Hotel h;
    printf("Enter Room Number: ");
    scanf("%d", &h.roomNo);
    printf("Enter Customer Name: ");
    scanf("%s", h.customer);
    printf("Enter Number of Days: ");
    scanf("%d", &h.days);
    printf("Enter Charge Per Day: ");
    scanf("%f", &h.charge);
    printf("\n----- Hotel Bill -----\n");
    printf("Room Number      : %d\n", h.roomNo);
    printf("Customer Name    : %s\n", h.customer);
    printf("Days Stayed      : %d\n", h.days);
    printf("Charge Per Day   : %.2f\n", h.charge);
    printf("Total Bill       : %.2f\n", h.days * h.charge);
    return 0;
}
